{
  "name": "pi-extensions-config",
  "version": "0.1.0",
  "description": "Shared portable JSON configuration I/O for Pi extensions",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "README.zh-CN.md",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm pack --dry-run --json > /dev/null"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "maplezzk",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-extensions-config",
  "bugs": "https://github.com/maplezzk/pi-extensions/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-extensions-config"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "configuration",
    "coding-agent"
  ],
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}

{
  "name": "pi-rewind",
  "version": "0.5.0",
  "description": "Git-backed checkpoints and safe file or conversation rewind for the Pi coding agent",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "locales",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx tests/core.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm pack --dry-run --json > /dev/null"
  },
  "pi": {
    "extensions": [
      "./index.ts",
      "../pi-extensions-i18n/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "arpagon",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-rewind",
  "bugs": {
    "url": "https://github.com/maplezzk/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-rewind"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "checkpoint",
    "rewind",
    "undo",
    "git"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1"
  },
  "dependencies": {
    "pi-extensions-i18n": "^0.8.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}

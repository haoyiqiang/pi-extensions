{
  "name": "pi-blackhole",
  "version": "0.5.10",
  "description": "Deterministic compaction, recall, and observational memory for the Pi coding agent",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "!src/**/*.test.ts",
    "locales",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt",
    "example-config.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm pack --dry-run --json > /dev/null"
  },
  "pi": {
    "extensions": [
      "./index.ts",
      "../pi-extensions-i18n/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "k0valik",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-blackhole",
  "bugs": {
    "url": "https://github.com/maplezzk/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-blackhole"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "blackhole",
    "compaction",
    "observational-memory",
    "recall"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1 <1.0.0",
    "@earendil-works/pi-ai": ">=0.85.1 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.85.1 <1.0.0",
    "@earendil-works/pi-tui": ">=0.85.1 <1.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.12.4",
    "typebox": "1.3.34",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "pi-extensions-i18n": "^0.8.0"
  }
}

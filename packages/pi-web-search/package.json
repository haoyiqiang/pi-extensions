{
  "name": "@maplezzk/pi-web-search",
  "version": "1.6.0",
  "description": "Lightweight LLM and API web search, URL context, and web fetch tools for Pi",
  "type": "module",
  "main": "./index.ts",
  "exports": "./index.ts",
  "files": [
    "i18n-entry.ts",
    "index.ts",
    "src",
    "locales",
    "config.example.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "PI-WEB-SEARCH-LICENSE",
    "RPIV-WEB-TOOLS-LICENSE"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm pack --dry-run --json > /dev/null"
  },
  "pi": {
    "extensions": [
      "./i18n-entry.ts",
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "maplezzk",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-web-search",
  "bugs": "https://github.com/maplezzk/pi-extensions/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-web-search"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "web-search",
    "url-context",
    "web-fetch",
    "vertex-ai"
  ],
  "dependencies": {
    "undici": "^7.29.1",
    "pi-utils": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}

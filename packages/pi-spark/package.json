{
  "name": "pi-spark",
  "version": "0.28.0",
  "description": "Pi package that polishes the daily experience: credits, presets, recap, titles, and a compact TUI",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "themes",
    "assets",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "SKILL.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm pack --dry-run --json > /dev/null"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./SKILL.md"
    ],
    "themes": [
      "./themes"
    ],
    "image": "https://raw.githubusercontent.com/zlliang/pi-spark/main/assets/cover.png"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "zlliang",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-spark",
  "bugs": {
    "url": "https://github.com/maplezzk/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-spark"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "credits",
    "presets",
    "recap",
    "theme"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "defu": "^6.1.7",
    "ky": "^2.0.2",
    "parse-duration": "^2.1.8",
    "pretty-ms": "^9.3.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.87.0 <1.0.0",
    "@earendil-works/pi-ai": ">=0.87.0 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0 <1.0.0",
    "@earendil-works/pi-tui": ">=0.87.0 <1.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.12.4",
    "typebox": "1.3.34",
    "typescript": "5.9.3"
  }
}

{
  "name": "pi-action-fusion",
  "version": "0.1.0",
  "description": "Fuse Pi file edits and writes with an optional follow-up shell command",
  "type": "module",
  "main": "./index.ts",
  "exports": { ".": "./index.ts" },
  "files": ["index.ts", "src", "config.example.json", "README.md", "README.zh-CN.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm pack --dry-run --json > /dev/null"
  },
  "pi": { "extensions": ["./index.ts", "../pi-extensions-i18n/index.ts"] },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "author": "maplezzk",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-action-fusion",
  "bugs": "https://github.com/maplezzk/pi-extensions/issues",
  "repository": { "type": "git", "url": "git+https://github.com/maplezzk/pi-extensions.git", "directory": "packages/pi-action-fusion" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "keywords": ["pi-package", "pi", "pi-extension", "coding-agent", "action-fusion"],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.87.1",
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "typebox": "^1.3.7"
  },
  "dependencies": { "pi-extensions-config": "^0.1.0", "pi-extensions-i18n": "^0.8.0" },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@maplezzk/pi-test-utils": "0.0.0",
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}

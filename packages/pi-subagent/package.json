{
  "name": "pi-subagent",
  "version": "0.1.0",
  "description": "Persistent Pi subagents in a terminal panel, managed by the subagent CLI",
  "type": "module",
  "main": "./index.ts",
  "bin": {
    "subagent": "./subagent.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "shared.ts",
    "subagent.ts",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm pack --dry-run --json > /dev/null"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "earendil-works",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-subagent",
  "bugs": "https://github.com/maplezzk/pi-extensions/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-subagent"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "subagent"
  ],
  "dependencies": {
    "pi-terminal-mux": "^0.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}

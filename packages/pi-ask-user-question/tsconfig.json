{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["index.ts", "ask-user-question.ts", "config.ts", "events.ts", "reconcile.ts", "rpc-fallback.ts", "state/**/*.ts", "tool/**/*.ts", "view/**/*.ts"],
  "exclude": ["**/*.test.ts", "tests/**", "vitest.config.ts"]
}

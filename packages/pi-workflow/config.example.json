{
  "execution": {
    "executor": "pi-subagents",
    "profile": "standard",
    "maxConcurrency": 4
  },
  "models": {
    "defaults": {
      "model": "provider/default-model",
      "thinking": "medium"
    },
    "stages": {
      "review": { "thinking": "high" }
    },
    "skills": {
      "quick-check": "provider/fast-model"
    },
    "presets": {
      "inspect": {
        "stages": {
          "review": { "model": "provider/review-model", "thinking": "off" }
        }
      }
    }
  }
}

{
  "name": "@maplezzk/pi-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Independent workflow engine with audited orchestration, cancellation, recovery, and unified Pi execution",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./startup": "./src/startup.ts",
    "./registration": "./src/registration.ts",
    "./runner": "./src/runner/index.ts",
    "./internal": "./src/internal.ts"
  },
  "files": [
    "index.ts",
    "extension.ts",
    "src",
    "locales",
    "config.example.json",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "UPSTREAM.md",
    "LICENSE",
    "!**/*.test.ts"
  ],
  "engines": { "node": ">=22" },
  "license": "MIT",
  "author": "juicesharp",
  "contributors": ["maplezzk"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-workflow"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extension.ts",
      "../pi-extensions-i18n/index.ts"
    ]
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "pi-extensions-config": "^0.1.0",
    "pi-extensions-i18n": "^0.8.0",
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1 <1.0.0",
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@sinclair/typebox": "0.34.49",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}

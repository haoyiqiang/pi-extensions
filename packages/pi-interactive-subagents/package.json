{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi with native tmux and Orca surfaces",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "test": "tsx --test test/test.ts test/lifecycle.test.ts test/role-loadout.test.ts test/terminal-lifecycle.test.ts test/loader.test.ts test/runtime-contract.test.ts test/identity.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "dependencies": {
    "@kevinhao/pi-terminal-mux": "^0.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "typebox": "^1.3.27"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "typebox": "1.3.27",
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}

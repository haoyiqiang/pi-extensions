{
  "name": "@kevinhao/pi-utils",
  "version": "0.1.1",
  "description": "Shared portable config I/O and deterministic test fixtures for Pi extensions",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./rpiv": "./src/rpiv/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "README.zh-CN.md",
    "RPIV-LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm pack --dry-run --json > /dev/null"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "maplezzk",
  "homepage": "https://github.com/haoyiqiang/pi-extensions/tree/main/packages/pi-utils",
  "bugs": "https://github.com/haoyiqiang/pi-extensions/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoyiqiang/pi-extensions.git",
    "directory": "packages/pi-utils"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi",
    "configuration",
    "coding-agent"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}

{
  "name": "@maplezzk/pi-advisor",
  "version": "0.1.0",
  "description": "A zero-parameter Pi advisor tool backed by a separately selected reviewer model",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "i18n-entry.ts",
    "advisor",
    "advisor-ui.ts",
    "fuzzy.ts",
    "src",
    "tests",
    "vitest.config.ts",
    "docs/upstream",
    "config.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "UPSTREAM.md",
    "!**/*.test.ts",
    "!tests",
    "!vitest.config.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck"
  },
  "pi": {
    "extensions": [
      "./i18n-entry.ts",
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "maplezzk",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-advisor",
  "bugs": {
    "url": "https://github.com/maplezzk/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-advisor"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "advisor",
    "reviewer"
  ],
  "dependencies": {
    "pi-utils": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.87.1 <1.0.0",
    "@earendil-works/pi-ai": ">=0.87.1 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.87.1 <1.0.0",
    "@earendil-works/pi-tui": ">=0.87.1 <1.0.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}

{
  "name": "pi-context-view",
  "version": "0.6.0",
  "description": "Pi extension to visualize context usage and inspect hidden prompt, tool, skill, and extension injections",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "doc",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "npm run typecheck",
    "check": "npm run typecheck && npm test && npm pack --dry-run --json > /dev/null"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://media.githubusercontent.com/media/dimk90/pi-context-view/9a9f9f4fafaa09c77759485d53c42f8694650755/doc/images/pi-context-view.png"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "author": "Dmitry Makarov",
  "homepage": "https://github.com/maplezzk/pi-extensions/tree/main/packages/pi-context-view",
  "bugs": {
    "url": "https://github.com/maplezzk/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplezzk/pi-extensions.git",
    "directory": "packages/pi-context-view"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "context",
    "tokens",
    "tui"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "@earendil-works/pi-tui": ">=0.86.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "tsx": "4.23.1"
  },
  "dependencies": {
    "pi-utils": "^0.1.0"
  }
}

{
  "name": "pi-extensions",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "packages/pi-extensions-i18n/index.ts",
      "packages/pi-spark/index.ts",
      "packages/pi-blackhole/index.ts",
      "packages/pi-context-view/index.ts",
      "packages/pi-distill/index.ts",
      "packages/pi-models-discovery/index.ts",
      "packages/pi-naming/index.ts",
      "packages/pi-rewind/index.ts",
      "packages/pi-web-search/index.ts",
      "packages/pi-interactive-subagents/index.ts"
    ],
    "themes": [
      "packages/pi-spark/themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1",
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "@earendil-works/pi-tui": ">=0.86.1"
  },
  "scripts": {
    "test": "node scripts/run-workspaces.mjs test && node --import tsx --test test/*.test.ts",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "check": "npm run typecheck && npm test && node scripts/check-no-local-bindings.mjs && node scripts/check-lockfile-registry.mjs && npm run check:boundaries && node scripts/check-package-config.mjs && npm run test:pack && node scripts/check-release-order.mjs && npm run test:release-publish-coverage",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:release-order": "node scripts/check-release-order.mjs",
    "test:pack": "node scripts/check-package-tarballs.mjs",
    "test:release-publish-coverage": "node --test scripts/release-publish-coverage.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "yaml": "^2.9.0"
  }
}
